# Groq API Key & Model (Required for LLM supervisor & specialist agents)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# PostgreSQL Connection String (Required for LangGraph state persistence / checkpointer)
# Example: postgresql://user:password@localhost:5432/tripmate or Render PostgreSQL URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tripmate

# Tavily API Key (Required for Hotel Search MCP)
TAVILY_API_KEY=your_tavily_api_key_here

# OpenWeather API Key (Required for Custom Weather MCP Server)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# AviationStack API Key (Required for Flights MCP Server)
AVIATION_STACK_API_KEY=your_aviationstack_api_key_here
